Extension { #name : 'CompiledBlock' }

{ #category : '*Calypso-SystemTools-ProcessBrowser' }
CompiledBlock >> critiques [
	^self method critiques
]

{ #category : '*Calypso-SystemTools-ProcessBrowser' }
CompiledBlock >> isExtension [
	^self method isExtension
]

{ #category : '*Calypso-SystemTools-ProcessBrowser' }
CompiledBlock >> isLiteralMethod [
	^self method isLiteralMethod
]

{ #category : '*Calypso-SystemTools-ProcessBrowser' }
CompiledBlock >> protocol: aProtocolName [
